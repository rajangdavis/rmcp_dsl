#!/usr/bin/env ruby
# frozen_string_literal: true

# Generates rbi/dsl.rbi (the Sorbet description of the DSL) from the compiler's
# SIG table, so Sorbet and the compiler cannot drift apart.
#
#   ruby bin/gen_rbi          write rbi/dsl.rbi
#   ruby bin/gen_rbi --check  exit 1 if rbi/dsl.rbi differs from what SIG produces
#
# Sorbet cannot constrain symbol VALUES (:i32 vs :bogus); the compiler's --check
# does that. This file only expresses nesting, keywords and argument types.
require "fileutils"

require_relative "../lib/rmcp_dsl/schema"

OUT = File.expand_path("../rbi/dsl.rbi", __dir__)

def scope(name) = "#{name.to_s.capitalize}Scope"

def sorbet_type(kind)
  return "String" if kind == :str
  return "T::Boolean" if kind == :bool
  return "T.any(Integer, Float)" if kind == :num
  return "Integer" if kind == :uint
  return "T.any(String, Integer, Float, T::Boolean)" if kind == :lit
  return "T::Hash[String, T.untyped]" if kind == :json
  return "T::Array[Symbol]" if kind == :types || kind == :htypes
  return "T::Array[String]" if kind == :strs
  return "T.any(Symbol, T.class_of(RmcpDsl::Opaque))" if kind == :fieldtype # :i64, map(:i64), or a type a binding owns

  "Symbol"
end

# Returns ["sig { ... }", "def name(...); end"] for one SIG entry.
def method_src(name, sig)
  names = sig.fetch(:names)
  raise "#{name}: names and pos differ in length" unless names.size == sig.fetch(:pos).size

  sparams = names.zip(sig[:pos]).map { |n, kind| "#{n}: #{sorbet_type(kind)}" }
  defs = names.map(&:to_s)
  # Sorbet wants required keywords before optional ones; keep the table's order within each group.
  sig[:kw].partition { |_, (_, required)| required }.flatten(1).each do |key, (kind, required)|
    if required
      sparams << "#{key}: #{sorbet_type(kind)}"
      defs << "#{key}:"
    else
      sparams << "#{key}: T.nilable(#{sorbet_type(kind)})"
      defs << "#{key}: nil"
    end
  end
  case sig[:block]
  when :decls
    sparams << "blk: T.proc.bind(#{scope(name)}).void"
    defs << "&blk"
  when :body
    sparams << "blk: T.untyped"
    defs << "&blk"
  end
  sigline = sparams.empty? ? "sig { void }" : "sig { params(#{sparams.join(', ')}).void }"
  [sigline, "def #{name}(#{defs.join(', ')}); end"]
end

by_ctx = Hash.new { |h, k| h[k] = [] }
RmcpDsl::SIG.each { |name, sig| Array(sig.fetch(:in)).each { |ctx| by_ctx[ctx] << [name, sig] } }

lines = [
  "# typed: strict",
  "# GENERATED by bin/gen_rbi from SIG in schema.rb. Do not edit.",
  ""
]
(by_ctx.keys - [:top]).each do |ctx|
  lines << "class #{scope(ctx)}"
  by_ctx[ctx].each_with_index do |(name, sig), i|
    lines << "" if i.positive?
    method_src(name, sig).each { |l| lines << "  #{l}" }
  end
  if %i[tool prompt resource].include?(ctx)
    # rust(:name, args...) calls a function declared with rust_fn; the compiler checks it.
    lines << "" << "  sig { params(name: Symbol, args: T.untyped).returns(T.untyped) }"
    lines << "  def rust(name, *args); end"
    # result(:Name, field: value) builds the structured output declared with `output`; the compiler checks the fields.
    lines << "" << "  sig { params(name: Symbol, fields: T.untyped).returns(T.untyped) }"
    lines << "  def result(name, **fields); end"
  end
  if ctx == :tool
    # text(...), image(...) and the other content builders: a tool body may end in one block or an array of them.
    annotated = "audience: T.nilable(T::Array[Symbol]), priority: T.nilable(T.any(Integer, Float))"
    [["text: String", "text(text, audience: nil, priority: nil)"],
     ["data: String, mime_type: String", "image(data, mime_type, audience: nil, priority: nil)"],
     ["data: String, mime_type: String", "audio(data, mime_type, audience: nil, priority: nil)"],
     ["uri: String, name: String, title: T.nilable(String), description: T.nilable(String), mime_type: T.nilable(String), size: T.nilable(Integer)",
      "resource_link(uri, name:, title: nil, description: nil, mime_type: nil, size: nil, audience: nil, priority: nil)"],
     ["uri: String, text: String, mime_type: T.nilable(String)", "embedded_text(uri, text, mime_type: nil, audience: nil, priority: nil)"],
     ["uri: String, data: String, mime_type: T.nilable(String)", "embedded_blob(uri, data, mime_type: nil, audience: nil, priority: nil)"]].each do |params, definition|
      lines << "" << "  sig { params(#{params}, #{annotated}).returns(ContentBlock) }"
      lines << "  def #{definition}; end"
    end
  end
  if %i[params output].include?(ctx)
    # map(:i64) and list(:string) name a field's type; the compiler reads them with Prism and checks the argument.
    lines << "" << "  sig { params(type: Symbol).returns(Symbol) }"
    lines << "  def map(type); end"
    lines << "" << "  sig { params(type: Symbol).returns(Symbol) }"
    lines << "  def list(type); end"
  end
  lines << "end" << ""
end
by_ctx[:top].each { |name, sig| lines.concat(method_src(name, sig)) << "" }
# Rust::Int32(x) / Rust::Int64(x) mark an integer as "treat this like Rust" (Sorbet just sees Integer).
lines.concat([
  "# What text(...), image(...) and the other content builders return.",
  "class ContentBlock; end",
  "",
  "module Rust",
  "  sig { params(value: Integer).returns(Integer) }",
  "  def self.Int32(value); end",
  "",
  "  sig { params(value: Integer).returns(Integer) }",
  "  def self.Int64(value); end",
  "end",
  "",
  "# The macros a binding file (bindings/*.rb) uses; the compiler reads them with Prism.",
  "module RmcpDsl",
  "  # A type a binding owns; the compiler reads `type_rust` with Prism.",
  "  class Opaque",
  "    sig { params(rust: String, wire: T::Boolean).void }",
  "    def self.type_rust(rust, wire: false); end",
  "  end",
  "",
  "  module BindingDsl",
  "    sig { params(name: String, version: String).void }",
  "    def crate(name, version); end",
  "",
  "    sig { params(template: String).void }",
  "    def rust(template); end",
  "",
  "    sig { params(reason: String).void }",
  "    def no_reference(reason); end",
  "",
  "    sig { params(method: Symbol, args: T.untyped, expect: T.untyped).void }",
  "    def example(method, *args, expect:); end",
  "  end",
  "end",
  "",
  "# Sorbet only knows Integer; the compiler reads the names to learn the width.",
  "I32 = T.type_alias { Integer }",
  "I64 = T.type_alias { Integer }",
  ""
])
text = lines.join("\n")

if ARGV.include?("--check")
  if File.exist?(OUT) && File.read(OUT) == text
    puts "rbi/dsl.rbi is up to date"
  else
    warn "rbi/dsl.rbi is stale or missing: run `ruby bin/gen_rbi`"
    exit 1
  end
else
  FileUtils.mkdir_p(File.dirname(OUT))
  File.write(OUT, text)
  puts "wrote #{OUT}"
end
